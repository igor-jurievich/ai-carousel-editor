# === OpenAI (текст карусели + фолбэк для картинок) ===
OPENAI_API_KEY=
# По умолчанию используется gpt-5.1; для другой модели (напр. gpt-5.5) задай тут:
OPENAI_GENERATION_MODEL=
GENERATE_TIMEOUT_MS=
GENERATE_RATE_LIMIT_MAX=
GENERATE_RATE_LIMIT_WINDOW_MS=

# === fal.ai (основной провайдер картинок карусели — GPT Image 2) ===
# Ключ: https://fal.ai/dashboard/keys — держи в секрете, в репозиторий не коммить.
FAL_KEY=
# Необязательно переопределить модель (по умолчанию fal-ai/gpt-image-2):
FAL_IMAGE_MODEL=
